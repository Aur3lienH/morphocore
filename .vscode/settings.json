{
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "LLVM",
    "[cpp]": {
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.formatOnSave": true
    },
    "[cuda-cpp]": {
        "editor.formatOnSave": true
    },
    "files.associations": {
        "*.cu": "cuda-cpp",
        "*.cuh": "cuda-cpp",
        "compare": "cpp",
        "cstdint": "cpp",
        "vector": "cpp",
        "limits": "cpp",
        "variant": "cpp",
        "cstddef": "cpp",
        "string": "cpp",
        "memory": "cpp",
        "format": "cpp",
        "functional": "cpp",
        "utility": "cpp",
        "type_traits": "cpp"
    }
}