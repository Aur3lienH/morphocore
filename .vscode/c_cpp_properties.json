{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/cuda/include",
                "${workspaceFolder}/.venv/include",
                "${workspaceFolder}/.venv/lib/python*/site-packages/torch/include",
                "${workspaceFolder}/.venv/lib/python*/site-packages/torch/include/torch/csrc/api/include"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c99",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "defines": [
                "WITH_CUDA"
            ]
        }
    ],
    
    "version": 4
}